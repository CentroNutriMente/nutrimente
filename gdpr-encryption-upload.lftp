set ftp:ssl-allow false
set ftp:passive-mode true
set net:timeout 60
set xfer:clobber on
# Crea le directory nuove (put non le crea da solo). -f ignora se già esistono.
mkdir -f -p www.saraalessandripsicologa.it/nutrimente_app/app/Casts
mkdir -f -p www.saraalessandripsicologa.it/nutrimente_app/app/Support
mkdir -f -p www.saraalessandripsicologa.it/nutrimente_app/app/Models/Concerns
mkdir -f -p www.saraalessandripsicologa.it/nutrimente_app/app/Console/Commands
# === Cifratura a riposo dei dati sensibili (GDPR) ===
